# Ondial_Webhook — provider ingress (api.ondial.ai / dev-api.ondial.ai)

PORT=9000
MONGODB_URI=mongodb://user:pass@host/ondial
REDIS_URL=redis://localhost:6379
TRUST_PROXY=1

# Telephony ingress auth (existing)
# WEBHOOK_SHARED_SECRET=
# WEBHOOK_HMAC_SECRET=
# WEBHOOK_INTERNAL_SECRET=

# AiSensy inbound (same secret as AiSensy dashboard + Ondial WEBHOOK_SECRET + Calling_system1)
# Live ingress:  https://api.ondial.ai/api/webhook/aisensy
# Test ingress:  https://dev-api.ondial.ai/api/webhook/aisensy
WEBHOOK_SECRET=
# Optional alias:
# AISENSY_WEBHOOK_SECRET=

# BullMQ queue name consumed by Calling_system1 scheduler (must match)
AISENSY_INBOUND_QUEUE_NAME=aisensy-inbound
# AISENSY_INBOUND_MAX_RETRIES=5
# AISENSY_INBOUND_BASE_RETRY_MS=1000
# Note: AISENSY_API_KEY / PROJECT_ID are NOT used here — outbound AiSensy is Ondial + CS1.

# Meta Cloud API WhatsApp ingress (exclusive alternative to AiSensy per tenant)
# Live:  https://api.ondial.ai/api/webhook/whatsapp
# Test:  https://dev-api.ondial.ai/api/webhook/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_META_INBOUND_QUEUE_NAME=whatsapp-meta-inbound
# WHATSAPP_META_INBOUND_MAX_RETRIES=5
# WHATSAPP_META_INBOUND_BASE_RETRY_MS=1000
# Local BullMQ consumer (same process / same Redis). Default true.
WHATSAPP_META_CONSUMER_ENABLED=true
# Graph send + AI relay (copy from Ondial / CS1 platform Meta env)
# Template Mongo updates use MONGODB_URI above (same DB as Ondial).
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_AI_REPLY_URL=
WHATSAPP_AI_REPLY_SECRET=
WHATSAPP_AI_RELAY_ENABLED=true
# If WHATSAPP_AI_REPLY_URL is empty, relay POSTs to ONDIAL_APP_URL/api/whatsapp/ai-reply
# All inbound WhatsApp events (Meta + AiSensy) are handled in this service.
# Same as Ondial/CS1 — decrypt own-account Meta profile tokens
TOKEN_ENCRYPTION_KEY=
REDIS_URL=redis://127.0.0.1:6379

# Ondial app callbacks (dashboard host)
# Live:  https://dashboard.ondial.ai
# Test:  https://dashboard-test.ondial.ai
ONDIAL_APP_URL=https://dashboard.ondial.ai
# Foreign (Twilio/Telnyx) analysis only. India/pool uses Calling_system1 ANALYSIS_API_URL.
ANALYSIS_API_URL=https://foreignscript.ondial.ai
# Emergency only: also trigger India/pool analysis from webhook (default off — CS1 owns India).
# WEBHOOK_TRIGGER_INDIA_ANALYSIS=false

# Telnyx Call Control — BEST APPROACH (status/billing only in webhook)
# Mission Control → Call Control App → webhook_event_url MUST be:
#   Dev:  https://dev-api.ondial.ai/telnyx/webhooks
#   Live: https://api.ondial.ai/telnyx/webhooks
# Do NOT use /twilio/call-status for Telnyx (causes 400 retries).
# Enable events: call.initiated, call.answered, call.hangup
# Optional: call.bridged, call.rejected, call.cost, call.recording.*
# Conversation turns: dialer posts POST /conversation { call_id (UUID), campaign_id, contact_id, turns }
# (Telnyx does not send transcripts in webhooks.)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_VERIFY=1
# TELNYX_WEBHOOK_MAX_SKEW_SEC=300
# TELNYX_WEBHOOK_EVENT_TTL_SEC=86400

# Twilio hangup (common /hangup + /twilio/hangup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WEBHOOK_INTERNAL_SECRET=

# Provider mapping ingress (no extra env on this service — Redis/Mongo already used)
# Calling_system1 posts here:
#   POST /api/twilio-mapping   { CallSid, call_id, campaign_id, contact_id }
#   POST /api/telnyx-mapping   { call_control_id, call_id, campaign_id, contact_id }
# Set on Calling: TWILIO_MAPPING_API_URL / TELNYX_MAPPING_API_URL

# Common provider APIs (auto-route by provider | CallSid | call_control_id):
#   POST /hangup
#   POST /conversation
# Legacy aliases still work: /twilio/hangup, /telnyx/hangup, /twilio/conversation, /telnyx/conversation
#
# The /hangup routes drop live calls, so they require ingress auth. Send one of:
#   x-webhook-secret: $WEBHOOK_INTERNAL_SECRET
#   Authorization: Bearer $WEBHOOK_INTERNAL_SECRET
#   x-webhook-timestamp + x-webhook-signature (HMAC over `${ts}.${rawBody}` with WEBHOOK_HMAC_SECRET)
# With NODE_ENV=production and neither secret set, /hangup returns 401 (fail closed).
