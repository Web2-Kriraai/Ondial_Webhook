# Ondial_Webhook — provider ingress (api.ondial.ai / dev-api.ondial.ai)

PORT=9000
MONGODB_URI=mongodb://user:pass@host/ondial
REDIS_URL=redis://localhost:6379
TRUST_PROXY=1

# Telephony ingress auth (existing)
# WEBHOOK_SHARED_SECRET=
# WEBHOOK_HMAC_SECRET=
# WEBHOOK_INTERNAL_SECRET=

# AiSensy inbound (same secret as AiSensy dashboard + Ondial WEBHOOK_SECRET + Calling_system1)
# Live ingress:  https://api.ondial.ai/api/webhook/aisensy
# Test ingress:  https://dev-api.ondial.ai/api/webhook/aisensy
WEBHOOK_SECRET=
# Optional alias:
# AISENSY_WEBHOOK_SECRET=

# BullMQ queue name consumed by Calling_system1 scheduler (must match)
AISENSY_INBOUND_QUEUE_NAME=aisensy-inbound
# AISENSY_INBOUND_MAX_RETRIES=5
# AISENSY_INBOUND_BASE_RETRY_MS=1000
# Note: AISENSY_API_KEY / PROJECT_ID are NOT used here — outbound AiSensy is Ondial + CS1.

# Ondial app callbacks (dashboard host)
# Live:  https://dashboard.ondial.ai
# Test:  https://dashboard-test.ondial.ai
ONDIAL_APP_URL=https://dashboard.ondial.ai
ANALYSIS_API_URL=https://sscript.ondial.ai

# Telnyx Call Control webhooks (Mission Control → webhook_event_url)
# Primary:  https://<webhook-host>/telnyx/webhooks
# Must return 2xx within ~2s (handler acks immediately, processes async).
# Public key: Mission Control → API Keys → Public Key
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_VERIFY=1
# TELNYX_WEBHOOK_MAX_SKEW_SEC=300
# TELNYX_WEBHOOK_EVENT_TTL_SEC=86400
# Call Control webhook_event_url must be: https://<host>/telnyx/webhooks

# Twilio hangup (common /hangup + /twilio/hangup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WEBHOOK_INTERNAL_SECRET=

# Provider mapping ingress (no extra env on this service — Redis/Mongo already used)
# Calling_system1 posts here:
#   POST /api/twilio-mapping   { CallSid, call_id, campaign_id, contact_id }
#   POST /api/telnyx-mapping   { call_control_id, call_id, campaign_id, contact_id }
# Set on Calling: TWILIO_MAPPING_API_URL / TELNYX_MAPPING_API_URL

# Common provider APIs (auto-route by provider | CallSid | call_control_id):
#   POST /hangup
#   POST /conversation
# Legacy aliases still work: /twilio/hangup, /telnyx/hangup, /twilio/conversation, /telnyx/conversation
#
# The /hangup routes drop live calls, so they require ingress auth. Send one of:
#   x-webhook-secret: $WEBHOOK_INTERNAL_SECRET
#   Authorization: Bearer $WEBHOOK_INTERNAL_SECRET
#   x-webhook-timestamp + x-webhook-signature (HMAC over `${ts}.${rawBody}` with WEBHOOK_HMAC_SECRET)
# With NODE_ENV=production and neither secret set, /hangup returns 401 (fail closed).
